<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F4F6F8"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="32dp"
        android:elevation="4dp"
        android:gravity="center">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginBottom="16dp"
            android:contentDescription="Logo Houston" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Houston, tenemos un ticket"
            android:textColor="#1F5FAD"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Proyecto 2º DAM - Gestión de Incidencias"
            android:textColor="#6C757D"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnIrLogin"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Iniciar Sesión"
            android:backgroundTint="#1F5FAD"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnIrRegistro"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Registrarse"
            android:backgroundTint="#6C757D"
            android:textColor="@android:color/white" />

    </LinearLayout>
</LinearLayout>
