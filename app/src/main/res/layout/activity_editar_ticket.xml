<?xml version="1.0" encoding="utf-8"?>
<!-- Layout para la edicion de un ticket existente -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- Toolbar superior con boton de retroceso -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarEditar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="Editar Incidencia"
        app:titleTextColor="@color/card_white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/card_white"
                android:padding="20dp"
                android:elevation="4dp">

                <!-- Titulo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Título *"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etEditarTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:inputType="textCapSentences"
                    android:background="@android:drawable/edit_text"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="16dp" />

                <!-- Categoria -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Categoría *"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerEditarCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="16dp" />

                <!-- Prioridad -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prioridad *"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerEditarPrioridad"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="16dp" />

                <!-- Descripcion -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción *"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etEditarDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:background="@android:drawable/edit_text"
                    android:padding="12dp"
                    android:layout_marginBottom="24dp" />

                <!-- Boton Guardar Cambios -->
                <Button
                    android:id="@+id/btnGuardarCambios"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Guardar Cambios"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/card_white"
                    android:layout_marginBottom="12dp" />

                <!-- Boton Cancelar -->
                <Button
                    android:id="@+id/btnCancelarEditar"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Cancelar"
                    android:backgroundTint="@color/secondary"
                    android:textColor="@color/card_white" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
