<?xml version="1.0" encoding="utf-8"?>
<!-- Layout para la pantalla principal del Rol ADMIN -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:padding="20dp">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvBienvenidaAdmin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bienvenido, Administrador"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCerrarSesionAdmin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Salir"
            android:backgroundTint="@color/error_red"
            android:textColor="@color/card_white"
            android:textSize="12sp"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Todos los Tickets del Sistema:"
        android:textColor="@color/text_main"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- RecyclerView con todos los tickets -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTicketsAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvSinTicketsAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay tickets registrados en el sistema."
        android:textColor="@color/text_muted"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

</LinearLayout>
