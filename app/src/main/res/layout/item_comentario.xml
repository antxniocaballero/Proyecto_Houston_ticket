<?xml version="1.0" encoding="utf-8"?>
<!-- Layout para un elemento individual en la lista de comentarios -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:elevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvComentarioAutor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nombre Autor (ROL)"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvComentarioFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--/--/----"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvComentarioTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Texto del comentario enviado por el usuario..."
        android:textColor="@color/text_main"
        android:textSize="14sp" />

</LinearLayout>
